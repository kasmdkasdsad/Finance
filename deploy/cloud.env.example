# QuantPulse cloud settings. `./qp setup` copies this file to deploy/.env on the SERVER, fills in the generated
# secrets and asks for the rest (your Alpaca PAPER keys and a dashboard password) without showing them.
# deploy/.env never leaves the server: git and the Docker build both ignore it. Never paste its contents
# into chat, email, a ticket or a screenshot.
#
# Everything not listed here keeps its safe default (see ../.env.example for the full list). The compose file
# forces QP_DEPLOYMENT=cloud, QP_ALPACA_PAPER=true and the PostgreSQL address; the API refuses to start unless
# `./qp preflight` passes.

# --- Secrets: generated by ./qp setup (letters and digits only) -------------------------------------------
POSTGRES_PASSWORD=
QP_API_TOKEN=
# The dashboard password's PBKDF2 hash (never the password): ./qp setup makes it, or ./qp password.
QP_DASHBOARD_PASSWORD_HASH=
# Optional read-only key: ./qp reader on sets it, ./qp reader off empties it (empty = no read-only access).
QP_API_READ_TOKEN=

# --- Alpaca PAPER account (app.alpaca.markets → Paper Trading → API Keys; paper key ids start with PK) -----
QP_ALPACA_API_KEY_ID=
QP_ALPACA_API_SECRET_KEY=
QP_ALPACA_PAPER=true
QP_ALPACA_STOCK_FEED=iex

# --- The Brain trades the PAPER account by itself (the same switches as on the PC) ---------------------------
QP_BRAIN_MODE=paper_execution
QP_BRAIN_SUPERVISOR_ENABLED=true
QP_ALPACA_TRADING_ENABLED=true
QP_TRADING_DRY_RUN=false
QP_TRADING_KILL_SWITCH=false
QP_BRAIN_KILL_SWITCH=false
QP_TRADING_SCHEDULER_REQUIRES_ARMING=true

# --- Market data and research ---------------------------------------------------------------------------------
QP_ENABLE_LIVE_DATA=true
# Market-data order stays the default (polygon,alpaca,yahoo); optional extra keys work as on the PC, e.g.
# QP_POLYGON_API_KEY=
# The SEC asks for a name and an e-mail address in the User-Agent (replace both).
QP_SEC_USER_AGENT=QuantPulse cloud your.email@example.com

# --- Alerts to your iPhone (optional, free) --------------------------------------------------------------------
# ntfy: install the ntfy app, subscribe to a long random topic, and put its URL here, e.g.
# https://ntfy.sh/qp-<30 random letters and digits>. Anyone who knows the topic can read the alerts: keep it secret.
QP_ALERT_NTFY_URL=
# Slack or Discord incoming webhook (optional).
QP_ALERT_WEBHOOK_URL=
# Dead-man's switch: a free healthchecks.io check's ping URL. It e-mails / pushes you when the pings stop
# (the server is down) — the one failure the server cannot report itself.
QP_HEARTBEAT_URL=

# --- Public HTTPS (only for `./qp start --public`; Tailscale needs none of this) ------------------------------
# A DNS name whose A record points at this server, e.g. quantpulse.example.com.
QP_PUBLIC_HOSTNAME=
