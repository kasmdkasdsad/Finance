# Installed by `./qp install-timers`. A verified pg_dump, uploaded off the server to Object Storage through a
# write-only link; an alert (and the backup heartbeat's /fail) when anything fails.
[Unit]
Description=QuantPulse nightly database backup (verified, uploaded off the server)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DEPLOY@
ExecStart=@DEPLOY@/qp backup nightly
TimeoutStartSec=2h
Nice=10
