#!/usr/bin/env bash
# qp — run QuantPulse on this server (Docker Compose). Every command prints what it does; none prints a secret.
#
#   ./qp setup                 first time: make deploy/.env (generated secrets, your Alpaca PAPER keys, a
#                              dashboard password) and build the image
#   ./qp preflight             check the configuration without starting anything (paper only, secured, ...)
#   ./qp host-preflight        the server's own check (runs before every start and deploy): nothing live anywhere
#   ./qp import-sqlite FILE    copy the PC's history (data/quantpulse.db) into the empty cloud database
#   ./qp start [--public]      build, preflight, start everything (--public: HTTPS on QP_PUBLIC_HOSTNAME)
#   ./qp status [--json]       the server at a glance: CPU, memory, disk, Docker, PostgreSQL, API, Brain
#                              supervisor, last cycle, heartbeat, backups, deployed commit and its CI result
#   ./qp logs [SERVICE]        follow the logs (api, dashboard, db, backup, caddy; default api)
#   ./qp restart [SERVICE]     restart (default: api and dashboard) with the current deploy/.env; the Brain
#                              recovers before any order
#   ./qp keys                  replace the Alpaca PAPER keys (asked, never shown), then ./qp restart
#   ./qp stop-trading [REASON] Brain kill switch ON: no new Brain orders, working Brain orders canceled
#   ./qp start-trading         Brain kill switch OFF (asks first)
#   ./qp update [COMMIT]       deploy the followed branch's newest commit (or COMMIT) now — only if GitHub CI
#                              passed on it; built and checked first, rolled back by itself if it fails
#   ./qp rollback [COMMIT]     back to the previous deployed version (or COMMIT); pauses automatic deploys
#   ./qp backup                a verified database backup now (deploy/backups; the nightly one also goes off
#                              the server to Object Storage)
#   ./qp restore FILE          replace the database with a backup (asks first)
#   ./qp restore-test [FILE]   restore the newest backup into a scratch database and check it
#   ./qp ci-gate [COMMIT]      would this commit be deployed? (GitHub CI, every required job, ARM64 included)
#   ./qp install-timers        systemd timers: watchdog (1 min), auto-update (10 min), nightly backup, weekly
#                              restore test (Oracle / any systemd server; see deploy/ORACLE.md)
#   ./qp watchdog | auto-update  what the timers run (by hand: once)
#   ./qp password              change the dashboard password
#   ./qp tailscale             publish the dashboard on your private Tailscale network (HTTPS)
#   ./qp reader on|off|key     read-only access on your tailnet: GETs to the monitoring pages, nothing else
#                              (a separate key; off revokes it at once)
#   ./qp down                  stop everything (the Brain stops; the timers leave it stopped; ./qp start)
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$HERE"
ENV_FILE="$HERE/.env"
HISTORY="$HERE/.deploy-history"
OPS=(python3 "$HERE/qpops.py")
dc() { docker compose -f "$HERE/compose.yaml" "$@"; }
say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
need_env() { [[ -f "$ENV_FILE" ]] || die "deploy/.env is missing: run ./qp setup first"; }

# Set NAME=VALUE in deploy/.env (or FILE); the value travels in the environment, never on a command line.
set_var() {
  QP_NAME="$1" QP_VALUE="$2" QP_FILE="${3:-$ENV_FILE}" python3 - <<'PY'
import os, re
name, value, path = os.environ["QP_NAME"], os.environ["QP_VALUE"], os.environ["QP_FILE"]
text = open(path, encoding="utf-8").read()
line = f"{name}={value}"
if re.search(rf"^{re.escape(name)}=.*$", text, flags=re.M):
    text = re.sub(rf"^{re.escape(name)}=.*$", lambda m: line, text, count=1, flags=re.M)
else:
    text = text.rstrip("\n") + "\n" + line + "\n"
open(path, "w", encoding="utf-8").write(text)
PY
}
get_var() { grep -E "^$1=" "$ENV_FILE" | head -1 | cut -d= -f2- || true; }
# The reader gateway runs only while the read-only key is set (./qp reader on); so does its compose profile.
reader_on() { [[ -n "$(get_var QP_API_READ_TOKEN)" ]]; }
reader_profile() { if reader_on; then printf '%s\n' --profile reader; fi; }
tailnet_name() { tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'; }

# Call the API from inside its own container (the token never leaves the server or shows up anywhere).
api_call() { # METHOD PATH [JSON]
  dc exec -T -e QP_M="$1" -e QP_P="$2" -e QP_B="${3:-}" api python - <<'PY'
import json, os, sys, urllib.request
req = urllib.request.Request("http://127.0.0.1:8000/api/v1" + os.environ["QP_P"], method=os.environ["QP_M"],
                             data=os.environ["QP_B"].encode() or None,
                             headers={"X-API-Key": os.environ.get("QP_API_TOKEN", ""), "Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=60) as r:
        print(r.read().decode())
except urllib.error.HTTPError as e:
    print(json.dumps({"http_error": e.code, "detail": e.read().decode()[:500]})); sys.exit(1)
PY
}

hash_password() {
  local pw pw2
  read -r -s -p "Dashboard password (at least 12 characters): " pw; echo >&2
  read -r -s -p "Again: " pw2; echo >&2
  [[ "$pw" == "$pw2" ]] || die "the two passwords differ"
  printf '%s\n' "$pw" | dc run --rm --no-deps -T api quantpulse-hash-password
}

wait_healthy() {
  say "waiting for the API to become healthy ..."
  for _ in $(seq 1 60); do
    if dc exec -T api python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" >/dev/null 2>&1; then
      say "API is up."; return 0
    fi
    sleep 5
  done
  dc logs --tail=60 api
  die "the API did not come up: see the log above (a failed preflight lists its FAIL lines)"
}

record_deploy() {
  git -C "$HERE/.." rev-parse HEAD >> "$HISTORY"
  local branch; branch="$(git -C "$HERE/.." rev-parse --abbrev-ref HEAD)"
  [[ "$branch" == "HEAD" ]] || echo "$branch" > "$HERE/.deploy-branch"  # what `update` follows
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup)
    command -v docker >/dev/null || die "Docker is not installed: run deploy/bootstrap.sh first"
    if [[ ! -f "$ENV_FILE" ]]; then
      cp "$HERE/cloud.env.example" "$ENV_FILE"
      say "created deploy/.env"
    fi
    chmod 600 "$ENV_FILE"
    [[ -n "$(get_var POSTGRES_PASSWORD)" ]] || { set_var POSTGRES_PASSWORD "$(openssl rand -hex 24)"; say "generated the database password"; }
    [[ -n "$(get_var QP_API_TOKEN)" ]] || { set_var QP_API_TOKEN "$(openssl rand -hex 32)"; say "generated the API token"; }
    if [[ -z "$(get_var QP_ALPACA_API_KEY_ID)" ]]; then
      read -r -s -p "Alpaca PAPER key id (starts with PK; not shown): " key; echo
      [[ "$key" == PK* ]] || die "that is not a paper key id (paper key ids start with PK)"
      read -r -s -p "Alpaca PAPER secret key (not shown): " secret; echo
      set_var QP_ALPACA_API_KEY_ID "$key"; set_var QP_ALPACA_API_SECRET_KEY "$secret"
      unset key secret
      say "saved the Alpaca paper keys"
    fi
    # Docker Compose needs every required value just to read the compose file, but the password hash is made
    # with the image built here: until it exists, a placeholder stands in for these two commands only (it is
    # never written to deploy/.env, and the dashboard cannot start without the real hash).
    [[ -n "$(get_var QP_DASHBOARD_PASSWORD_HASH)" ]] || export QP_DASHBOARD_PASSWORD_HASH="not-set-yet"
    say "building the image (a few minutes the first time) ..."
    dc build api
    if [[ -z "$(get_var QP_DASHBOARD_PASSWORD_HASH)" ]]; then
      hashed="$(hash_password)"; set_var QP_DASHBOARD_PASSWORD_HASH "$hashed"; unset hashed
      say "saved the dashboard password hash"
    fi
    unset QP_DASHBOARD_PASSWORD_HASH
    if [[ ! -f "$HERE/ops.env" ]]; then  # host-only settings (never given to a container)
      cp "$HERE/ops.env.example" "$HERE/ops.env"
      branch="$(git -C "$HERE/.." rev-parse --abbrev-ref HEAD)"
      [[ "$branch" == "HEAD" ]] || set_var QP_DEPLOY_BRANCH "$branch" "$HERE/ops.env"
      say "created deploy/ops.env (auto-update follows ${branch})"
    fi
    chmod 600 "$HERE/ops.env"
    mkdir -p "$HERE/state" "$HERE/backups" && chmod 700 "$HERE/state"
    say "setup done. Next: ./qp preflight, then (optional) ./qp import-sqlite, then ./qp start"
    ;;
  preflight)
    need_env
    dc run --rm --no-deps -T api quantpulse-preflight
    ;;
  import-sqlite)
    need_env
    src="${1:-}"; [[ -f "$src" ]] || die "usage: ./qp import-sqlite /path/to/quantpulse.db (stop QuantPulse on the PC first)"
    say "stopping the API (if running) and starting the database ..."
    dc stop api dashboard >/dev/null 2>&1 || true
    dc up -d db
    mkdir -p "$HERE/import" && cp "$src" "$HERE/import/quantpulse.db" && chmod -R a+rwX "$HERE/import"
    for ext in -wal -shm; do
      if [[ -f "$src$ext" ]]; then cp "$src$ext" "$HERE/import/quantpulse.db$ext"; fi
    done
    # shellcheck disable=SC2016  # $QP_DATABASE_URL expands inside the container (the password stays there)
    dc run --rm --no-deps -T -v "$HERE/import:/import" api \
      sh -c 'quantpulse-transfer --source sqlite+aiosqlite:////import/quantpulse.db --target "$QP_DATABASE_URL"'
    rm -rf "$HERE/import"
    say "history imported. Start with ./qp start"
    ;;
  start)
    need_env
    # the server's own preflight first (paper only, nothing live anywhere, cloud mode forced): see qpops.py
    "${OPS[@]}" host-preflight || die "server preflight failed: nothing was started"
    profile=()
    if [[ "${1:-}" == "--public" ]]; then
      access="$(grep -E '^QP_DASHBOARD_ACCESS=' "$HERE/ops.env" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
      [[ "${access:-tailscale}" == "public" ]] || die "the dashboard is reached through Tailscale only (QP_DASHBOARD_ACCESS=tailscale in deploy/ops.env); set it to public first to open HTTPS to the internet"
      [[ -n "$(get_var QP_PUBLIC_HOSTNAME)" ]] || die "set QP_PUBLIC_HOSTNAME in deploy/.env first"
      profile=(--profile public)
    fi
    dc build --build-arg QP_GIT_COMMIT="$(git -C "$HERE/.." rev-parse HEAD)" api
    dc run --rm --no-deps -T api quantpulse-preflight || die "preflight failed: nothing was started"
    rm -f "$HERE/state/stopped"
    mapfile -t reader < <(reader_profile)
    dc "${profile[@]}" "${reader[@]}" up -d
    record_deploy
    "${OPS[@]}" record-start || true
    wait_healthy
    "$0" status
    ;;
  status)
    need_env
    exec "${OPS[@]}" status "$@"
    ;;
  logs)
    need_env
    dc logs -f --tail=200 "${1:-api}"
    ;;
  restart)
    need_env
    # recreated, not just restarted: a container keeps the settings it was created with, so a plain restart
    # would ignore changes to deploy/.env (new keys, alert URLs); the API still stops gracefully first
    services=(api dashboard)
    if reader_on; then services+=(reader); fi
    if [[ $# -gt 0 ]]; then dc up -d --no-deps --force-recreate "$@"; else dc up -d --no-deps --force-recreate "${services[@]}"; fi
    wait_healthy
    ;;
  keys)
    need_env
    read -r -s -p "New Alpaca PAPER key id (starts with PK; not shown): " key; echo
    [[ "$key" == PK* ]] || die "that is not a paper key id (paper key ids start with PK): nothing was changed"
    read -r -s -p "New Alpaca PAPER secret key (not shown): " secret; echo
    [[ -n "$secret" ]] || die "no secret given: nothing was changed"
    set_var QP_ALPACA_API_KEY_ID "$key"; set_var QP_ALPACA_API_SECRET_KEY "$secret"
    unset key secret
    say "saved the new Alpaca paper keys. Apply them: ./qp restart"
    ;;
  stop-trading)
    need_env
    reason="${*:-stopped from the server (./qp stop-trading)}"
    body="$(QP_R="$reason" python3 -c 'import json, os; print(json.dumps({"active": True, "reason": os.environ["QP_R"], "cancel_open_orders": True}))')"
    out="$(api_call POST /brain/kill-switch "$body")" || { echo "$out" >&2; die "the Brain kill switch could not be set"; }
    say "Brain kill switch ON: no new Brain orders. Working Brain orders are canceled (retried every minute if Alpaca is unreachable)."
    ;;
  start-trading)
    need_env
    read -r -p "Allow the Brain to send paper orders again? Type YES: " ok
    [[ "$ok" == "YES" ]] || die "nothing changed"
    out="$(api_call POST /brain/kill-switch '{"active": false}')" || { echo "$out" >&2; die "the Brain kill switch could not be released"; }
    say "Brain kill switch OFF."
    ;;
  backup)
    need_env
    exec "${OPS[@]}" backup "${1:-manual}"
    ;;
  restore-test)
    need_env
    exec "${OPS[@]}" restore-test "$@"
    ;;
  ci-gate|watchdog|auto-update|sample|host-preflight)
    need_env
    exec "${OPS[@]}" "$cmd" "$@"
    ;;
  install-timers)
    command -v systemctl >/dev/null || die "systemd is required for the timers"
    user="$(stat -c %U "$HERE/..")"
    [[ "$user" == "root" ]] || id -nG "$user" | grep -qw docker || die "$user must be in the docker group (bootstrap does it; log in again)"
    for unit in "$HERE"/systemd/quantpulse-*.service "$HERE"/systemd/quantpulse-*.timer; do
      sed -e "s#@DEPLOY@#$HERE#g" -e "s#@USER@#$user#g" "$unit" | sudo tee "/etc/systemd/system/$(basename "$unit")" >/dev/null
    done
    sudo systemctl daemon-reload
    sudo systemctl enable --now quantpulse-watchdog.timer quantpulse-update.timer quantpulse-backup.timer \
      quantpulse-restore-test.timer
    systemctl list-timers 'quantpulse-*' --no-pager
    say "timers installed (running as $user). Logs: journalctl -u 'quantpulse-*' -e"
    ;;
  restore)
    need_env
    file="${1:-}"; [[ -f "$file" ]] || die "usage: ./qp restore deploy/backups/quantpulse-....dump"
    read -r -p "This REPLACES the whole database with $file. Type RESTORE: " ok
    [[ "$ok" == "RESTORE" ]] || die "nothing changed"
    "$0" backup
    dc stop api dashboard
    name="$(basename "$file")"; cp "$file" "$HERE/backups/$name" 2>/dev/null || true
    dc exec -T backup pg_restore --clean --if-exists --no-owner -d quantpulse "/backups/$name"
    dc up -d
    wait_healthy
    ;;
  update)
    need_env
    # a backup, the build of exactly that commit, its preflight, then the switch and a check that the Brain
    # ticks; the old version comes back by itself if not. Only commits whose GitHub CI passed are deployed.
    exec "${OPS[@]}" deploy "$@"
    ;;
  rollback)
    need_env
    target="${1:-}"
    if [[ -z "$target" ]]; then
      [[ -f "$HISTORY" ]] || die "no deploy history yet"
      current="$(git -C "$HERE/.." rev-parse HEAD)"
      target="$(grep -v "^$current$" "$HISTORY" | tail -1)"
      [[ -n "$target" ]] || die "no earlier deployment recorded"
    fi
    mkdir -p "$HERE/state" && echo "$target" > "$HERE/state/pin"  # automatic deploys pause until ./qp update
    "$0" backup
    head_then="$(git -C "$HERE/.." ls-tree --name-only "$target" src/quantpulse/db/migrations/versions/ | grep -oE '/[0-9]{4}_' | tr -d '/_' | sort | tail -1)"
    say "rolling back to $target (database schema $head_then) ..."
    # the schema goes back first, with the current code (it knows how to undo its own migrations), while the
    # API is stopped; the Brain then recovers on the older version before it sends anything
    dc stop api dashboard
    dc run --rm --no-deps -T api quantpulse-migrate "$head_then" --downgrade || die "the schema could not be rolled back; the backup above is safe (./qp start resumes the current version)"
    git -C "$HERE/.." checkout --detach "$target"
    exec "$HERE/qp" start  # the older version's script
    ;;
  password)
    need_env
    hashed="$(hash_password)"; set_var QP_DASHBOARD_PASSWORD_HASH "$hashed"; unset hashed
    dc up -d dashboard
    say "dashboard password changed"
    ;;
  tailscale)
    command -v tailscale >/dev/null || die "install Tailscale first: curl -fsSL https://tailscale.com/install.sh | sh && sudo tailscale up"
    sudo tailscale serve --bg --https=443 http://127.0.0.1:8501
    say "Dashboard on your tailnet: https://$(tailnet_name)"
    ;;
  reader)
    need_env
    case "${1:-}" in
      on)
        command -v tailscale >/dev/null || die "install Tailscale first (bootstrap-oracle.sh does it; then ./qp tailscale)"
        [[ ! -f "$HERE/state/stopped" ]] || die "QuantPulse is stopped (./qp down): ./qp start first"
        if ! reader_on; then
          set_var QP_API_READ_TOKEN "$(openssl rand -hex 32)"
          say "generated the read-only key"
        fi
        # the API learns the key: recreated, so it stops gracefully and the Brain recovers before any order
        say "restarting the API with the read-only key (a graceful restart, like a deploy) ..."
        dc up -d --no-deps --force-recreate api
        wait_healthy
        dc --profile reader up -d --no-deps --force-recreate reader
        sudo tailscale serve --bg --https=8443 http://127.0.0.1:8090
        say "Read-only access is on: https://$(tailnet_name):8443 (your tailnet only)"
        echo "It reads the monitoring pages (GET requests) and nothing else: no order, control, switch or setting."
        echo "The read-only key (send it as the X-API-Key header). Keep it out of chats, emails and GitHub:"
        echo "  $(get_var QP_API_READ_TOKEN)"
        echo "Revoke it at any time with ./qp reader off."
        ;;
      off)
        if command -v tailscale >/dev/null; then sudo tailscale serve --https=8443 off || true; fi
        dc --profile reader rm -sf reader || true
        set_var QP_API_READ_TOKEN ""
        say "restarting the API without the read-only key (a graceful restart) ..."
        dc up -d --no-deps --force-recreate api
        wait_healthy
        say "Read-only access is off: the key no longer works."
        ;;
      key)
        reader_on || die "read-only access is off (./qp reader on)"
        get_var QP_API_READ_TOKEN
        ;;
      *)
        die "usage: ./qp reader on | off | key"
        ;;
    esac
    ;;
  down)
    need_env
    mkdir -p "$HERE/state" && touch "$HERE/state/stopped"  # the watchdog and auto-update leave it stopped
    dc --profile public --profile reader stop
    say "stopped. Start again with ./qp start"
    ;;
  help|*)
    sed -n '2,33p' "$HERE/qp" | sed 's/^# \{0,1\}//'
    ;;
esac
