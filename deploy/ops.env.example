# deploy/ops.env — the SERVER's own settings and secrets (auto-update, watchdog, off-site backups).
# `./qp setup` copies this file to deploy/ops.env (chmod 600). It is ignored by git, excluded from the Docker
# build, and never given to any container: the Alpaca keys and the database password stay in deploy/.env.

# ---- automatic deploys (./qp install-timers: every 10 minutes) -----------------------------------------------
# the GitHub repository (owner/name) and the branch this server follows; the repository is read from the git
# remote when QP_DEPLOY_REPO is empty
QP_DEPLOY_REPO=
QP_DEPLOY_BRANCH=
# true: deploy a new commit once GitHub CI passed every required job on exactly that commit (ARM64 included)
QP_AUTO_UPDATE=true
# closed: only outside 08:00-17:30 New York on weekdays (weekends any time); any: whenever CI passes
QP_AUTO_UPDATE_WINDOW=closed
# only for a PRIVATE repository: a fine-grained, read-only token for this one repository
# (Repository permissions: Contents = Read, Actions = Read, Metadata = Read). Leave empty for a public one.
GITHUB_TOKEN=

# ---- the supervisor watchdog (every minute) ------------------------------------------------------------------
QP_WATCHDOG=true

# ---- the dashboard -------------------------------------------------------------------------------------------
# tailscale: reached only through your private Tailscale network (./qp tailscale); `./qp start --public` refuses
# public: allows the optional caddy profile (HTTPS on your own domain, ports 80/443 open to the internet)
QP_DASHBOARD_ACCESS=tailscale

# ---- off-site backups (nightly) ------------------------------------------------------------------------------
# an Oracle Object Storage pre-authenticated request on your backup bucket, access type "Permit object writes"
# (write-only: this server cannot read, list or delete what it uploads), e.g.
#   https://objectstorage.<region>.oraclecloud.com/p/<secret>/n/<namespace>/b/<bucket>/o/
QP_BACKUP_PAR_URL=
# a healthchecks.io check (period 1 day, grace 2 hours): pinged after each nightly backup, /fail when it fails —
# and it alerts you when no backup arrives at all (the server is down)
QP_BACKUP_HEARTBEAT_URL=

# ---- alerts from the server itself (deploys, watchdog restarts, backup failures) ------------------------------
# empty: the same ntfy topic as the app (QP_ALERT_NTFY_URL in deploy/.env)
QP_OPS_NTFY_URL=
