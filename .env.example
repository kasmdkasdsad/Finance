# QuantPulse Terminal configuration. Copy to `.env` and fill in what you have.
# Every provider key is OPTIONAL: without it the platform fails over to the next source and, as a last
# resort, to clearly-labelled synthetic data.

# --- Runtime -------------------------------------------------------------------------------------
QP_ENVIRONMENT=development
QP_LOG_LEVEL=INFO
QP_LOG_JSON=false
QP_DATABASE_URL=sqlite+aiosqlite:///./data/quantpulse.db
QP_AUTO_MIGRATE=true
# If set, every /api/v1 request must send `X-API-Key: <token>` (the Streamlit sidebar has a field for it).
QP_API_TOKEN=
QP_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Live data -----------------------------------------------------------------------------------
QP_ENABLE_LIVE_DATA=true
# Market-data failover order (quotes, bars, option chains). Yahoo needs no key.
QP_MARKET_PROVIDERS=polygon,alpaca,yahoo
QP_POLYGON_API_KEY=
QP_POLYGON_REQUESTS_PER_MINUTE=5
# Alpaca PAPER keys (app.alpaca.markets → Paper Trading → API Keys). They serve market data and the paper
# trading API. The SDK's own names APCA_API_KEY_ID / APCA_API_SECRET_KEY are accepted too.
QP_ALPACA_API_KEY_ID=
QP_ALPACA_API_SECRET_KEY=
QP_ALPACA_STOCK_FEED=iex
QP_ALPACA_OPTIONS_FEED=indicative
# Consensus estimates (falls back to Yahoo quoteSummary without it).
QP_FMP_API_KEY=
# Weekly regional retail fuel prices (free key: https://www.eia.gov/opendata/register.php).
QP_EIA_API_KEY=
# Consensus betting lines across US books (https://the-odds-api.com). ESPN lines are used otherwise.
QP_ODDS_API_KEY=
# The SEC requires a descriptive User-Agent with contact details for EDGAR API access.
QP_SEC_USER_AGENT=Your Name your.email@example.com

# --- Background polling -------------------------------------------------------------------------
QP_POLLING_ENABLED=true
QP_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA
QP_POLL_QUOTES_MARKET_HOURS_SECONDS=15
QP_POLL_QUOTES_OFF_HOURS_SECONDS=300
QP_POLL_RATES_SECONDS=3600
QP_POLL_SPORTS_SECONDS=60

# --- Finance defaults ----------------------------------------------------------------------------
QP_EQUITY_RISK_PREMIUM=0.05
QP_DEFAULT_CREDIT_SPREAD=0.015
QP_DEFAULT_TAX_RATE=0.21
QP_BENCHMARK_SYMBOL=SPY

# --- Vehicle -------------------------------------------------------------------------------------
# EIA region code: NUS (U.S.), R1Z (Lower Atlantic), SFL (Florida), SCA (California), YMIA (Miami), ...
QP_FUEL_REGION=NUS
QP_FUEL_GRADE=regular

# --- Daily picks email digest --------------------------------------------------------------------
QP_PICKS_EMAIL_ENABLED=false
QP_PICKS_RECIPIENTS=you@example.com
QP_PICKS_SEND_TIME=08:45
QP_PICKS_TOP_N=10
# Never mail picks computed from synthetic prices unless this is true (the email is then clearly marked).
QP_PICKS_ALLOW_SYNTHETIC_EMAIL=false
QP_SMTP_HOST=smtp.gmail.com
QP_SMTP_PORT=587
QP_SMTP_SECURITY=starttls
QP_SMTP_USERNAME=
QP_SMTP_PASSWORD=
QP_EMAIL_FROM=

# --- Paper-trading sandbox (simulated money only; nothing is sent to a broker) -------------------
QP_SANDBOX_SCHEDULER_ENABLED=true
# Auto-trading agents rebalance once per trading day at this New York time...
QP_SANDBOX_TRADE_TIME=10:00
# ...and every account is marked to market after the close.
QP_SANDBOX_MARK_TIME=16:05

# --- Alpaca PAPER trading (Alpaca's paper API: simulated money only; there is no live-money setting) --------
# Safe start: nothing is sent to Alpaca until BOTH of these change (true / false).
QP_ALPACA_TRADING_ENABLED=false
QP_TRADING_DRY_RUN=true
# Must stay true: QuantPulse refuses to start with anything else.
QP_ALPACA_PAPER=true
# Refuse every new order (the dashboard also has a runtime kill switch).
QP_TRADING_KILL_SWITCH=false
# Strategy cycles: the first at QP_TRADING_TIME (New York), then every N minutes until 15 minutes before the close.
QP_TRADING_SCHEDULER_ENABLED=true
QP_TRADING_TIME=10:00
QP_TRADING_REBALANCE_INTERVAL_MINUTES=30
# Universe: auto = the stock model's universe (S&P 500 with Alpaca) + the ETFs below, narrowed to the most liquid.
QP_TRADING_UNIVERSE=auto
QP_TRADING_UNIVERSE_SIZE=120
QP_TRADING_ETFS=SPY,QQQ,IWM,DIA,XLF,XLK,XLE,SMH
# Position, portfolio and order limits (fractions of account equity).
QP_TRADING_MAX_POSITION_PCT=0.30
QP_TRADING_MAX_TOTAL_EXPOSURE_PCT=0.95
QP_TRADING_MAX_POSITIONS=8
QP_TRADING_MIN_POSITION_PCT=0.03
QP_TRADING_CASH_BUFFER_PCT=0.02
QP_TRADING_MAX_ORDER_NOTIONAL=15000
QP_TRADING_MIN_ORDER_NOTIONAL=100
# Losses: stop opening positions at a 4% daily loss (flatten = also sell everything); 8% stop-loss per position.
QP_TRADING_MAX_DAILY_LOSS_PCT=0.04
QP_TRADING_DAILY_LOSS_ACTION=halt
QP_TRADING_MAX_POSITION_LOSS_PCT=0.08
QP_TRADING_TAKE_PROFIT_PCT=0.25
QP_TRADING_TAKE_PROFIT_FRACTION=0.5
# Long-only (must stay false) and live data only (never synthetic; never stale unless this is false).
QP_TRADING_ALLOW_SHORTS=false
QP_TRADING_REQUIRE_LIVE_DATA=true
QP_TRADING_MAX_QUOTE_AGE_SECONDS=600
# Liquidity.
QP_TRADING_MIN_PRICE=5
QP_TRADING_MIN_DOLLAR_VOLUME=25000000
QP_TRADING_MAX_SPREAD_BPS=30
QP_TRADING_MAX_ADV_PCT=0.01
# Orders: marketable_limit (limit priced through the quote), limit (at the last price) or market.
QP_TRADING_ORDER_TYPE=marketable_limit
QP_TRADING_LIMIT_OFFSET_BPS=10
QP_TRADING_ORDER_TIMEOUT_MINUTES=20
QP_TRADING_FILL_WAIT_SECONDS=15
# Signal thresholds and anti-churn controls.
QP_TRADING_ENTRY_THRESHOLD=0.75
QP_TRADING_EXIT_THRESHOLD=0.0
QP_TRADING_INCUMBENT_BONUS=0.35
QP_TRADING_MIN_WEIGHT_CHANGE=0.02
QP_TRADING_COOLDOWN_MINUTES=120
QP_TRADING_MAX_CYCLE_TURNOVER_PCT=0.6
QP_TRADING_POSITION_VOL_BUDGET=0.12
QP_TRADING_VOL_FLOOR=0.12
QP_TRADING_EARNINGS_BLACKOUT_DAYS=2
QP_TRADING_USE_IMPLIED_VOL=true
QP_TRADING_MODEL_WAIT_SECONDS=5
# Opportunity-score weights (JSON or name=value pairs) and the regime maps.
QP_TRADING_SIGNAL_WEIGHTS=momentum=0.25,trend=0.20,volume=0.10,volatility=0.10,fundamental=0.10,model=0.20,regime=0.05
QP_TRADING_REGIME_EXPOSURE=bullish=1.0,neutral=0.8,high_volatility=0.6,bearish=0.4,risk_off=0.15
QP_TRADING_REGIME_ENTRY_PENALTY=bullish=0,neutral=0.15,high_volatility=0.3,bearish=0.5,risk_off=1.0

# --- Prediction ledger (logs forecasts after each close, grades them on their target date) ------
QP_PREDICTIONS_ENABLED=true
QP_PREDICTIONS_LOG_TIME=16:20
# Never recommended: synthetic predictions would pollute the track record.
QP_PREDICTIONS_ALLOW_SYNTHETIC=false
# How long a stock-model run is reused (seconds).
QP_TTL_MODEL=21600

# --- Stock model -------------------------------------------------------------------------------------
# auto = the S&P 500 (point-in-time, former members included) when Alpaca keys are set, else the picks list.
# Also: sp500, picks, or a comma-separated list of at least 3 tickers.
QP_MODEL_UNIVERSE=auto
# ensemble (ridge + gradient-boosted trees), ridge or gbm.
QP_MODEL_TYPE=ensemble
# Compare each stock's features with its industry peers (Fama-French 12 from SEC SIC codes).
QP_MODEL_SECTOR_NEUTRAL=true
# How long a request waits for a model run before it continues in the background (HTTP 202 + progress).
QP_MODEL_SYNC_WAIT_SECONDS=25
# Let the poller start each new close's model run on its own.
QP_MODEL_WARMUP=true

# --- Forecasts ---------------------------------------------------------------------------------------
# Weight of options-implied volatility in forecast volatility (0 = GARCH only).
QP_FORECAST_IV_WEIGHT=0.5
# Implied variance is divided by this before blending (options usually overprice risk).
QP_FORECAST_VARIANCE_PREMIUM=1.1
# Simulate the next earnings reaction as a jump sized from the stock's own past reactions.
QP_FORECAST_EARNINGS_JUMPS=true

# --- Reference data (S&P 500 membership, SEC profiles, earnings dates, XBRL frames) ------------------
QP_TTL_REFERENCE=604800
QP_TTL_FUNDAMENTALS_FRAMES=604800
