# QuantPulse Terminal configuration. Copy to `.env` and fill in what you have.
# Every provider key is OPTIONAL: without it the platform fails over to the next source and, as a last
# resort, to clearly-labelled synthetic data.

# --- Runtime -------------------------------------------------------------------------------------
QP_ENVIRONMENT=development
QP_LOG_LEVEL=INFO
QP_LOG_JSON=false
QP_DATABASE_URL=sqlite+aiosqlite:///./data/quantpulse.db
QP_AUTO_MIGRATE=true
# If set, every /api/v1 request must send `X-API-Key: <token>` (the Streamlit sidebar has a field for it).
QP_API_TOKEN=
QP_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Live data -----------------------------------------------------------------------------------
QP_ENABLE_LIVE_DATA=true
# Market-data failover order (quotes, bars, option chains). Yahoo needs no key.
QP_MARKET_PROVIDERS=polygon,alpaca,yahoo
QP_POLYGON_API_KEY=
QP_POLYGON_REQUESTS_PER_MINUTE=5
QP_ALPACA_API_KEY_ID=
QP_ALPACA_API_SECRET_KEY=
QP_ALPACA_STOCK_FEED=iex
QP_ALPACA_OPTIONS_FEED=indicative
# Consensus estimates (falls back to Yahoo quoteSummary without it).
QP_FMP_API_KEY=
# Weekly regional retail fuel prices (free key: https://www.eia.gov/opendata/register.php).
QP_EIA_API_KEY=
# Consensus betting lines across US books (https://the-odds-api.com). ESPN lines are used otherwise.
QP_ODDS_API_KEY=
# The SEC requires a descriptive User-Agent with contact details for EDGAR API access.
QP_SEC_USER_AGENT=Your Name your.email@example.com

# --- Background polling -------------------------------------------------------------------------
QP_POLLING_ENABLED=true
QP_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA
QP_POLL_QUOTES_MARKET_HOURS_SECONDS=15
QP_POLL_QUOTES_OFF_HOURS_SECONDS=300
QP_POLL_RATES_SECONDS=3600
QP_POLL_SPORTS_SECONDS=60

# --- Finance defaults ----------------------------------------------------------------------------
QP_EQUITY_RISK_PREMIUM=0.05
QP_DEFAULT_CREDIT_SPREAD=0.015
QP_DEFAULT_TAX_RATE=0.21
QP_BENCHMARK_SYMBOL=SPY

# --- Vehicle -------------------------------------------------------------------------------------
# EIA region code: NUS (U.S.), R1Z (Lower Atlantic), SFL (Florida), SCA (California), YMIA (Miami), ...
QP_FUEL_REGION=NUS
QP_FUEL_GRADE=regular

# --- Daily picks email digest --------------------------------------------------------------------
QP_PICKS_EMAIL_ENABLED=false
QP_PICKS_RECIPIENTS=you@example.com
QP_PICKS_SEND_TIME=08:45
QP_PICKS_TOP_N=10
# Never mail picks computed from synthetic prices unless this is true (the email is then clearly marked).
QP_PICKS_ALLOW_SYNTHETIC_EMAIL=false
QP_SMTP_HOST=smtp.gmail.com
QP_SMTP_PORT=587
QP_SMTP_SECURITY=starttls
QP_SMTP_USERNAME=
QP_SMTP_PASSWORD=
QP_EMAIL_FROM=

# --- Paper-trading sandbox (simulated money only; nothing is sent to a broker) -------------------
QP_SANDBOX_SCHEDULER_ENABLED=true
# Auto-trading agents rebalance once per trading day at this New York time...
QP_SANDBOX_TRADE_TIME=10:00
# ...and every account is marked to market after the close.
QP_SANDBOX_MARK_TIME=16:05
